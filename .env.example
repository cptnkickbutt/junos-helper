# Copy this file to .env and fill in local development values.
JUNOS_HOST=
JUNOS_USERNAME=
JUNOS_PASSWORD=
JUNOS_SSH_PORT=22

# Lab-only escape hatch: connect without first adding the device to known_hosts.
# Secure host-key verification remains the default when this is false.
JUNOS_ALLOW_UNKNOWN_HOST_KEY=false

# Saved-device profiles are appended here by the UI as
# JUNOS_DEVICE_<HOSTNAME_ID>_{HOSTNAME,HOST,USERNAME,PASSWORD}.
# Keep this file local and never commit the populated .env file.

JUNOS_BIND_HOST=127.0.0.1
JUNOS_BIND_PORT=8000
JUNOS_DEBUG=false

# Optional override; defaults to %LOCALAPPDATA%\Junos Helper\activity.sqlite3.
JUNOS_HELPER_ACTIVITY_LOG_PATH=
